# Prepared 2026-10-06. Copy to .env.local and fill in from your Supabase
# project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key (server only — never expose to the browser).
# Used by the Stripe webhook to credit deposits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Stripe (server only). Restricted secret key from the Stripe dashboard,
# plus the signing secret of the webhook endpoint that sends
# checkout.session.completed to /api/webhooks/stripe.
STRIPE_SECRET_KEY=sk_live_your-restricted-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
